# Copy this file to .env and fill in real values.
# `.env` is gitignored; `.env.example` is committed as documentation.

ENVIRONMENT=development

MONGO_URL=mongodb://localhost:27017
MONGO_DB_NAME=audit_logs
MONGO_COLLECTION=entries

# Required. HS256 shared secret, minimum 16 characters.
# For solo dev: any string ≥16 chars works.
# For integration: replace with the instructor-distributed value.
JWT_SECRET=replace_me_with_a_real_secret_min_16_chars

JWT_ALGORITHM=HS256

HOST=127.0.0.1
PORT=8000

# Admin UI credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=__GENERATE_WITH_make_admin_password_hash_SCRIPT__
ADMIN_JWT_LIFETIME_HOURS=24
